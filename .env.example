# ==============================================================================
# Personal Assistant Web - Configurações de Conexão aos Microserviços
# ==============================================================================
# Configure aqui as URLs dos microserviços de backend.
# Ao migrar de domínio (Registro.br <-> Cloudflare), basta alterar os valores abaixo.

# Opção 1: Endpoints individuais (padrão local ou subdomínios)
AUTH_SERVICE_URL=http://localhost:8082
HEALTH_SERVICE_URL=http://localhost:8081
FINANCIAL_SERVICE_URL=http://localhost:8080
BOT_GATEWAY_URL=http://localhost:8081

# Opção 2: Domínio unificado via Ingress ou Cloudflare Tunnel (se aplicável)
# API_BASE_URL=https://api.meudominio.com.br
